+b.plane
  +e.inner.inner
    +e.head
      +e.H2.title Планировки
      +e.P.text В ЖК «Новая Кузнечиха» предусмотрено несколько вариантов планировочных решений, включающих как классические планировки, так и квартиры евро формата с совмещенными кухней и гостинной. Новая очередь застройки отличается разнообразием квартир с эргономичными планировками по доступной цене.
    +e.body
      +e.control
        +e.filter
          +e.LABEL.radio
            +e.INPUT.hidden(type="radio" name="room" value='Студия' checked)
            +e.SPAN.txt Студия
          +e.LABEL.radio
            +e.INPUT.hidden(type="radio" name="room" value='1')
            +e.SPAN.txt 1
          +e.LABEL.radio
            +e.INPUT.hidden(type="radio" name="room" value='2')
            +e.SPAN.txt 2
          +e.LABEL.radio
            +e.INPUT.hidden(type="radio" name="room" value='3')
            +e.SPAN.txt 3
          +e.LABEL.radio
            +e.INPUT.hidden(type="radio" name="room" value='4')
            +e.SPAN.txt 4
        +e.buts
          +e.A.submit.btn Смотреть все варианты
            span 1 230 
          .slider-arrows
            +b.slider-arrow_prev
              svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
                path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m10 19-9-9 9-9')
            +b.slider-arrow_next
              svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
                path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m1 19 9-9-9-9')
