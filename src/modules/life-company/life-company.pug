+b.life-company
  +e.inner.inner
    +e.head
      +e.H2.title Награды и премии
      .slider-arrows
        +b.slider-arrow_prev
          svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
            path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m10 19-9-9 9-9')
        +b.slider-arrow_next
          svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
            path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m1 19 9-9-9-9')

    +e.wrapper
      +e.box
        .swiper
          .swiper-wrapper
            .swiper-slide
              +e.IMG.pic(src='/img/life-company-1.jpg' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/life-company-2.jpg' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/life-company-3.jpg' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/life-company-1.jpg' alt='')