mixin beautification(title)
  +b.beautification
    +e.inner.inner
      if title == true
        +e.head
          +e.H2.title Благоустройство
          +e.text С каждым годом растет и развивается коммерческая инфраструктура в ЖК «Новая Кузнечиха». На первых этажах домов уже работают супермаркеты и продуктовые лавки, аптеки, частные медицинские центры, зоомагазины, кафе, салоны красоты и другие необходимые для комфортной жизни объекты.
      else if title != undefined
        +e.head
          +e.H2.title=title
      +e.wrapper
        .swiper
          .swiper-wrapper
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
          .slider-arrows
            +b.slider-arrow_prev._gray
              svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
                path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m10 19-9-9 9-9')
            +b.slider-arrow_next._gray
              svg(xmlns='http://www.w3.org/2000/svg' width='11' height='20' fill='none' viewBox='0 0 11 20')
                path(stroke='#13151a' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m1 19 9-9-9-9')
      +e.thumbs
        .swiper
          .swiper-wrapper
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
            .swiper-slide
              +e.IMG.pic(src='/img/excursion-1.png' alt='')
        +e.more + 40